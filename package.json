{
  "name": "gto-poker-overlay",
  "version": "0.8.0",
  "description": "Fully local No-Limit Hold'em bot for authorised PokerNow bot competitions (Chrome MV3 extension), with an offline 2-10 player simulator. Built on the gto-poker-overlay toolkit.",
  "scripts": {
    "build": "tsc --noEmit -p . && webpack --mode production",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "solve:bench": "npx tsx src/solver/bench.ts",
    "solve:preflop": "npx tsx src/solver/preflop/run-solve.ts",
    "solve:equity": "npx tsx src/solver/preflop/build-equity.ts",
    "eval:bench": "npx tsx src/core/equity/eval-bench.ts",
    "ml:prep": "npx tsx ml/prep.ts",
    "ml:train": "python3 ml/train.py",
    "ml:verify": "npx tsx ml/verify.ts",
    "ml:fixtures": "npx tsx ml/build-fixtures.ts && npx tsx ml/build-parity-inputs.ts && npx tsx ml/export-weights.ts && python3 ml/parity-gen.py",
    "sim": "npx tsx sim/run.ts",
    "sim:selftest": "npx tsx sim/run.ts --selftest && npx tsx sim/ring-run.ts --selftest",
    "sim:ring": "npx tsx sim/ring-run.ts",
    "sim:match": "npx tsx sim/match.ts",
    "play": "npx tsx sim/play/server.ts",
    "play:e2e": "npx tsx sim/play/e2e.ts",
    "lint": "eslint \"src/**/*.ts\" \"ml/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"ml/**/*.ts\" \"tests/**/*.ts\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"ml/**/*.ts\" \"tests/**/*.ts\"",
    "build:legacy": "webpack --config webpack.legacy.config.js --mode production",
    "test:bot": "vitest run tests/bot",
    "bot:sim": "tsx sim/bot/run.ts",
    "bot:bench": "tsx sim/bot/bench.ts",
    "bot:e2e": "tsx sim/bot/e2e-extension.ts",
    "bot:e2e:recommend": "tsx sim/bot/e2e-extension.ts --recommend-only",
    "bot:e2e:dashboard": "tsx sim/bot/e2e-dashboard.ts",
    "bot:replay": "tsx sim/bot/replay-bundle.ts",
    "bot:decisions": "tsx sim/bot/replay-decisions.ts",
    "bot:ranges": "tsx sim/bot/ranges.ts",
    "bot:scenarios": "tsx sim/bot/scenarios-run.ts",
    "bot:strategy-bench": "tsx sim/bot/strategy-bench.ts",
    "bot:strategy-diag": "tsx sim/bot/strategy-diag.ts",
    "bot:lead-sensitivity": "tsx sim/bot/lead-sensitivity.ts",
    "bot:response-calibration": "tsx sim/bot/response-calibration.ts",
    "bot:audit": "tsx sim/bot/audit-bundle.ts",
    "bot:audit-hand": "tsx sim/bot/audit-hand.ts",
    "bot:reference": "tsx sim/bot/reference-eval.ts",
    "bot:independent-bench": "tsx sim/bot/independent-bench.ts",
    "bot:river": "tsx sim/bot/river-compare.ts",
    "bot:ml-compare": "tsx sim/bot/ml-compare.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "fake-indexeddb": "^6.2.8",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^24.1.3",
    "playwright": "^1.65.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "poker-odds-calculator": "^0.4.0"
  }
}
