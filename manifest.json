{
  "manifest_version": 3,
  "name": "Poker Bot for PokerNow (local engine)",
  "version": "0.5.1",
  "description": "Fully local No-Limit Hold'em engine for authorised PokerNow bot competitions: state tracking, multiway equity, opponent profiles, recommendations and guarded autonomous play.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pokernow.club/games/*",
        "https://pokernow.club/games/*",
        "https://www.pokernow.com/games/*",
        "https://pokernow.com/games/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poker bot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
